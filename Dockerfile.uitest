FROM ubuntu:22.04

# Avoid prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies and Imlib2 for UI rendering
RUN apt-get update && apt-get install -y \
    build-essential \
    libimlib2-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /src

# Default command
CMD ["/bin/bash"]
